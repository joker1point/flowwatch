# ---------------------------------------------------------------------------
# flowwatch .gitignore
# 运行期数据：历史层 SQLite 库及 WAL 附属文件、运行日志，属于本机运行产物，不入库
# ---------------------------------------------------------------------------
history.db
history.db-journal
history.db-wal
history.db-shm

# 流量助手的记忆库：运行期产物，且含对话内容 —— 绝不入库
assistant_memory.db
*.db-journal
*.db-wal
*.db-shm

# 运行期日志与临时产物
_run/
*.log

# Catrace「flowwatch-alert」插件 sidecar 运行时状态（不入库）
integrations/flowwatch-alert/runtime/state.json

# ETW 采集产物（logman/tracerpt 会生成几 MB 的二进制，绝不入库）
*.etl
*.etl.csv

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# 虚拟环境
.venv/
venv/
env/
ENV/

# ---------------------------------------------------------------------------
# 前端 / Node
# ---------------------------------------------------------------------------
node_modules/
dist/
.vite/

# ---------------------------------------------------------------------------
# 编辑器 / 系统
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# 含 API key，勿提交
.env

# UI 保存的模型配置（含 API key，勿提交）
assistant_config.json

# 笔记区运行期数据：用户便签 + AI 生成的真实流量画像（含真实进程/域名/IP）
# 三个文件都由 notes.py 首次启动时自动生成（内置人格写在代码 BUILTIN_PERSONAS 里），
# 目录也会自动创建，因此整个目录都不入库
notes/

# 临时备份文件（例：assistant.py.bak-flowwatch-ai）
*.bak-*
