// flowwatch 助手行为评估集 · 用例定义（每行一条 JSON，空行与 // 开头行会被跳过）
// 字段：id / category / notes / seed_memory? / live_skip? / runs[{question, script, expect}]
// script = 脚本化"模型"的响应序列（scripted 档用；live 档忽略）
// expect 支持的判据见 run_eval.py 的 _assert_run（工具/参数/证据标志/档位/上下文/记忆/描述文案）
{"id":"rank-global-01","category":"排行","notes":"最基础一题：必须查完整排行（不带 match），且答案不带'未核实'前缀","runs":[{"question":"现在谁在占带宽最多？","script":[{"tool_calls":[{"name":"get_top_processes","args":{"minutes":60,"limit":8}}]},{"content":"近 60 分钟排行：Steam++.Accelerator.exe（#84812）约 1018.3 MiB，其后是 Doubao.exe 两个进程合计约 19.5 MiB。"}],"expect":{"scope":"aggregate","grounded":true,"retried":false,"tools_all_of":["get_top_processes"],"tools_none_of":["get_live_connections"],"offered_tools_none_of":["get_live_connections"],"tool_args":{"get_top_processes":{"match":null}},"answer_prefix_not":"⚠️","model_calls":2}}]}
{"id":"rank-memory-scope-02","category":"排行","notes":"记忆里有 watchlist，但问全局时必须仍查不带 match 的完整排行（提示词里写死的红线）","seed_memory":{"watchlist":"盯 Doubao.exe（09-20 起，怀疑它在跑心跳）"},"runs":[{"question":"现在谁在占带宽最多？","script":[{"tool_calls":[{"name":"get_top_processes","args":{"minutes":60,"limit":10}}]},{"content":"全局排行第一仍是 Steam++.Accelerator.exe（约 1018 MiB）；Doubao.exe 不在前列。"}],"expect":{"tools_all_of":["get_top_processes"],"tool_args":{"get_top_processes":{"match":null}},"prompt_contains":["Doubao.exe"],"grounded":true}}]}
{"id":"match-hit-01","category":"点名检索","notes":"小写 doubao 要命中 Doubao.exe，并标记这是全量检索（不是扫榜）","runs":[{"question":"doubao 这个进程最近一小时有流量吗？","script":[{"tool_calls":[{"name":"get_top_processes","args":{"minutes":60,"match":"doubao","group":true}}]},{"content":"有：Doubao.exe 两个进程（#50164 / #50304）合计约 19.5 MiB。"}],"live_expect_any":[{"tools_all_of":["get_top_processes"]},{"tools_all_of":["get_top_domains"]}],"expect":{"tools_all_of":["get_top_processes"],"tool_args":{"get_top_processes":{"match":"doubao"}},"tool_result_contains":{"get_top_processes":"全量"},"grounded":true}}]}
{"id":"match-miss-01","category":"点名检索","notes":"查不到时的口径：说'没有流量记录'，不能说'进程不存在'","runs":[{"question":"notexistapp 最近一小时有流量吗？","script":[{"tool_calls":[{"name":"get_top_processes","args":{"minutes":60,"match":"notexistapp"}}]},{"content":"这段时间没有它的流量记录；这不等于进程不存在。"}],"expect":{"tools_all_of":["get_top_processes"],"tool_result_field":{"get_top_processes":{"matched":false}},"tool_result_contains":{"get_top_processes":"不等于进程没在跑"},"grounded":true}}]}
{"id":"identity-miss-01","category":"身份","notes":"按名找不到 pid 时，工具要给出'不等于进程没在运行'的提示（正例依赖真实机器，评估集不固化）","runs":[{"question":"notexistapp 是哪个软件？","script":[{"tool_calls":[{"name":"get_process_identity","args":{"match":"notexistapp"}}]},{"content":"按名字没有查到它的流量记录，拿不到 pid，所以读不到身份信息。"}],"expect":{"tools_all_of":["get_process_identity"],"offered_tools_all_of":["get_process_identity"],"tool_result_field":{"get_process_identity":{"found":false}},"tool_result_contains":{"get_process_identity":"不等于进程没在运行"}}}]}
{"id":"events-01","category":"事件","notes":"问'某应用最近有没有异常'要给 match + minutes（事件是稀疏数据，没窗口看不出'没有'）","runs":[{"question":"doubao 最近一小时有异常吗？","script":[{"tool_calls":[{"name":"get_events","args":{"minutes":60,"match":"doubao","limit":20}}]},{"content":"有 1 条：09-20 09:53 Doubao.exe（#50164）连续 3 分钟无流量。"}],"expect":{"tools_all_of":["get_events"],"tool_args":{"get_events":{"minutes":60,"match":"doubao"}},"grounded":true}}]}
{"id":"memory-write-01","category":"记忆写入","live_skip":"会写真实记忆库（记忆块是 agent 级，跨会话可见）","notes":"记忆写入的当前口径：问题里点了 .exe 属'数据类'，只调记忆工具 → 会被打'未核实'前缀（已知行为，待决定是否放宽）","runs":[{"question":"帮我盯着 Doubao.exe，它老在后台跑流量","script":[{"tool_calls":[{"name":"memory_insert","args":{"label":"watchlist","text":"盯 Doubao.exe（2026-09-21 起，疑似后台心跳）"}}]},{"content":"已记到 watchlist。"}],"expect":{"tools_all_of":["memory_insert"],"memory_block":{"watchlist":"Doubao.exe"},"grounded":false,"answer_prefix":"⚠️"}}]}
{"id":"memory-dup-01","category":"记忆写入","live_skip":"会写真实记忆库","notes":"同一内容重复写入必须被拒（块每轮注入，重复只是灌水）","seed_memory":{"watchlist":"盯 Doubao.exe"},"runs":[{"question":"再记一次：盯着 Doubao.exe","script":[{"tool_calls":[{"name":"memory_insert","args":{"label":"watchlist","text":"盯 Doubao.exe"}}]},{"content":"这条已经在 watchlist 里了，没有重复写入。"}],"expect":{"tool_result_field":{"memory_insert":{"ok":false}}}}]}
{"id":"memory-recall-01","category":"记忆召回","live_skip":"会写真实记忆库","notes":"跨轮召回：第 2 轮上下文里必须能看到第 1 轮写进 findings 的结论（记忆是背景，仍会被判非证据 → 带前缀）","runs":[{"question":"记一下：2026-09-20 核实过 Doubao.exe 收发的是心跳包（出/入≈1:1）","script":[{"tool_calls":[{"name":"memory_insert","args":{"label":"findings","text":"2026-09-20 核实：Doubao.exe 收发的是心跳包（出/入≈1:1）"}}]},{"content":"已记下。"}],"expect":{"memory_block":{"findings":"心跳包"}}},{"question":"Doubao.exe 的通信特征是什么？","script":[{"content":"按已核实的结论（09-20）：心跳包特征，出/入≈1:1。"}],"expect":{"prompt_contains":["心跳包"],"grounded":false,"answer_prefix":"⚠️"}}]}
{"id":"repeat-question-01","category":"重复提问","notes":"同一问题问第二遍：旧问答对必须被移出上下文（只加 system 提醒拦不住复读）","runs":[{"question":"现在谁在占带宽最多？","script":[{"tool_calls":[{"name":"get_top_processes","args":{"minutes":60,"limit":8}}]},{"content":"第一名是 Steam++.Accelerator.exe，约 1018 MiB。"}],"expect":{"tools_all_of":["get_top_processes"]}},{"question":"现在谁在占带宽最多？","script":[{"tool_calls":[{"name":"get_top_processes","args":{"minutes":60,"limit":8}}]},{"content":"重新核实了一遍：Steam++.Accelerator.exe 仍居首（约 1018 MiB）。"}],"live_expect_any":[{"tools_all_of":["get_top_processes"]},{"grounded":false,"answer_prefix":"⚠️"}],"expect":{"prompt_not_contains":["第一名是 Steam++.Accelerator.exe"],"prompt_contains":["已问过同样的问题"],"tools_all_of":["get_top_processes"]}}]}
{"id":"grounding-retry-01","category":"证据纠正","notes":"09-20 事故的回归：首轮零工具调用且问题要本机数据 → 强制纠正一轮，纠正后拿到证据则不打未核实","runs":[{"question":"doubao 收发的是心跳包吗？","script":[{"content":"查不到 doubao 的进程，我看了排行榜和事件流都没有。"},{"tool_calls":[{"name":"get_top_processes","args":{"minutes":60,"match":"doubao","group":true}}]},{"content":"Doubao.exe 两个进程合计约 19.5 MiB，出/入≈9:1。"}],"live_expect_any":[{"grounded":true,"answer_prefix_not":"⚠️"},{"grounded":false,"answer_prefix":"⚠️"}],"expect":{"retried":true,"grounded":true,"model_calls":3,"prompt_contains":["没有调用任何工具"],"answer_prefix_not":"⚠️"}}]}
{"id":"grounding-unverified-02","category":"证据纠正","notes":"纠正后仍无证据 → 必须显式标注'未核实'（宁可难看，不许冒充查过）","runs":[{"question":"doubao 收发的是心跳包吗？","script":[{"content":"查不到。"},{"content":"确实查不到。"}],"live_expect_any":[{"grounded":true,"answer_prefix_not":"⚠️"},{"grounded":false,"answer_prefix":"⚠️"}],"expect":{"retried":true,"grounded":false,"model_calls":2,"answer_prefix":"⚠️"}}]}
{"id":"grounding-memory-only-03","category":"证据纠正","notes":"只调记忆工具 = 假证据（实测：只调 memory_insert 就编出'占出向带宽 62%'）—— 必须判非证据","runs":[{"question":"doubao 现在占多少带宽？","script":[{"tool_calls":[{"name":"memory_insert","args":{"label":"findings","text":"Doubao.exe 占出向带宽 62%"}}]},{"content":"它占出向带宽 62%。"}],"live_expect_any":[{"grounded":true,"answer_prefix_not":"⚠️"},{"grounded":false,"answer_prefix":"⚠️"}],"expect":{"tools_all_of":["memory_insert"],"tools_none_of":["get_top_processes"],"grounded":false,"answer_prefix":"⚠️","model_calls":2}}]}
{"id":"scope-detail-01","category":"分档","notes":"问'连了谁/明细'才升明细档：明细工具必须真的可用","runs":[{"question":"Steam++ 连了谁？给我对端明细","script":[{"tool_calls":[{"name":"get_live_connections","args":{"pid":84812,"limit":10}}]},{"content":"它的对端是 10.44.99.5:49716。"}],"expect":{"scope":"detail","offered_tools_all_of":["get_live_connections"],"tools_all_of":["get_live_connections"],"tool_args":{"get_live_connections":{"pid":84812}}}}]}
{"id":"scope-aggregate-02","category":"分档","notes":"隐私承诺的验法：聚合档下明细工具**压根不注入给模型**（不是提示词拜托它别用）","runs":[{"question":"最近一小时的进程排行","script":[{"tool_calls":[{"name":"get_top_processes","args":{"minutes":60,"limit":8}}]},{"content":"排行第一是 Steam++.Accelerator.exe。"}],"expect":{"scope":"aggregate","offered_tools_all_of":["get_top_processes","get_process_identity"],"offered_tools_none_of":["get_live_connections"],"tools_none_of":["get_live_connections"]}}]}
{"id":"args-invalid-01","category":"工具契约","notes":"参数越界由 Pydantic 拦住，错误作为观察结果回给模型（不抛异常、不中断回合）；另记一个已知口径问题：失败的工具调用目前仍被计成 evidence（grounded=true）","runs":[{"question":"看下排行","script":[{"tool_calls":[{"name":"get_top_processes","args":{"minutes":60,"limit":999}}]},{"content":"按默认条数重新看：第一是 Steam++.Accelerator.exe。"}],"expect":{"tool_result_contains":{"get_top_processes":"参数不合法"},"model_calls":2,"grounded":true}}]}
{"id":"max-turns-01","category":"循环护栏","notes":"模型一直调工具时必须在 MAX_TURNS(6) 收口，并如实说明'先把已查到的结果给你'","runs":[{"question":"现在谁在占带宽最多？","script":[{"tool_calls":[{"name":"get_top_processes","args":{"minutes":60,"limit":8}}]},{"tool_calls":[{"name":"get_top_processes","args":{"minutes":60,"limit":8}}]},{"tool_calls":[{"name":"get_top_processes","args":{"minutes":60,"limit":8}}]},{"tool_calls":[{"name":"get_top_processes","args":{"minutes":60,"limit":8}}]},{"tool_calls":[{"name":"get_top_processes","args":{"minutes":60,"limit":8}}]},{"tool_calls":[{"name":"get_top_processes","args":{"minutes":60,"limit":8}}]}],"expect":{"model_calls":6,"answer_contains_all":["达到工具调用轮数上限"],"grounded":true}}]}
{"id":"unsupported-process-domain-01","category":"不可答问","notes":"进程↔域名关联历史层没落库：这条边界必须写在 SYSTEM_PROMPT 与工具描述里（否则模型只能靠猜）","runs":[{"question":"Steam++ 这个进程连过哪些域名？","script":[{"content":"历史层没有'进程→域名'的关联（只有明细档的实时窗口能看到），这个问题我答不了。"}],"expect":{"system_prompt_contains":["历史层答不了"],"tool_description_contains":{"get_top_domains":"历史层不保存进程与域名的关联"}}}]}
